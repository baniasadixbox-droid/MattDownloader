man  \nDiscord⇨   / discord  \nInstagram ⇨   / thekouman  \nTik Tok ⇨   / thekouman  \n_______________________________________________________ \nKOUMAN LOVES YOU! NOW LOVE KOUMAN BACK! \n#kouman #koumando #miaplays #کومان \n\nHarki Kouman negah nakone oskole! \n#kouman #dogmnabash #koumando #miaplays #کومان \n\nHarki dogm nabash negah nakone oskole!","commandRuns":[{"startIndex":395,"length":14,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwiotfDV3bSUAxXUyJUCHTlhNK1I5M2J9-jehtTtAcoBBE0TKQg=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbEkyelZUa3BtYWVrZ1p1elJCa3BoQ0J0Zm5GZ3xBQ3Jtc0tsa0hBZWxFejd4SjcybDdSWUtHVDJqUWxqdnZ0OEtfNXVmbjM3VS1wZlpxR21acVJRV25kbVlMdnlDeDFkWGctcTZxYmFhelJDX1o1U1lta1VZbTB5NXJIZ3UxbDZtVTl5QVV3QmJFTjdBZkRMR0ZpSQ\u0026q=https%3A%2F%2Fwww.instagram.com%2Fshaawnnx\u0026v=7aga9o7iZuQ","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbEkyelZUa3BtYWVrZ1p1elJCa3BoQ0J0Zm5GZ3xBQ3Jtc0tsa0hBZWxFejd4SjcybDdSWUtHVDJqUWxqdnZ0OEtfNXVmbjM3VS1wZlpxR21acVJRV25kbVlMdnlDeDFkWGctcTZxYmFhelJDX1o1U1lta1VZbTB5NXJIZ3UxbDZtVTl5QVV3QmJFTjdBZkRMR0ZpSQ\u0026q=https%3A%2F%2Fwww.instagram.com%2Fshaawnnx\u0026v=7aga9o7iZuQ","target":"TARGET_NEW_WINDOW","nofollow":true}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"Instagram Channel Link: shaawnnx"}}},{"startIndex":537,"length":15,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBQQ040EGAYiEwiotfDV3bSUAxXUyJUCHTlhNK1I5M2J9-jehtTtAcoBBE0TKQg=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUFFLUhqbDlFNDc0N1hXTTgyWjJuNXROeXo1dzhiekswQXxBQ3Jtc0tsNldBdEREcGRFMk5MWjRnOHJjZXFub2laVV9EZTQ2aGthdFY3NDhLeC1PcVYxWVNNVUJCUnh2R0FDS2VxUDJIb1ZTclZHVW93dXFCWF9kdnR4a2ZPS1N5YVRFRWJRVnNXYkczazl1VTA2VzNXZjlXYw\u0026q=https%3A%2F%2Ftwitter.com%2Ft